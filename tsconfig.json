{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "zero-ecs": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
